# Copia este archivo como .env y rellénalo. NUNCA subas .env a GitHub.
# En Render no hay .env: estas mismas variables van en el panel Environment.

# Modelo: deepseek o gemini (la nube) o local (Ollama en tu equipo; no funciona en Render)
MODO=deepseek
# Clave de https://platform.deepseek.com (la que usa MODO=deepseek)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# Solo para MODO=gemini y para los embeddings del RAG: no la borres si cambias de modelo.
# Clave gratis en https://aistudio.google.com/apikey (proyecto SIN facturación)
GEMINI_API_KEY_LOCAL=
GEMINI_MODEL=gemini-3.5-flash-lite

OLLAMA_MODEL=gemma4:e2b

# Telegram: el token de @BotFather y los números de chat que pueden usar el bot (separados por coma).
# Para saber tu número, activa polling local (abajo), arranca uvicorn y escribe /start.
TELEGRAM_TOKEN=
TELEGRAM_PERMITIDOS=
# Solo para probar Telegram EN LOCAL con el mismo servidor de la web.
# Poner true borra el webhook de Render: deja false si el bot ya está desplegado.
TELEGRAM_POLLING_LOCAL=false

# Extra opcional (API.md): tokens de la API HTTP, uno por persona, separados por coma.
# Genera uno con: uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKENS=

# Interfaz web (WEB.md): configuración de la sesión.
# Firma la cookie de sesión: genera uno con `uv run python -c "import secrets; print(secrets.token_urlsafe(32))"`
SESION_SECRETO=
# true en Render (https), false en tu equipo (http)
COOKIE_SEGURA=false
